<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Constructor</title>
</head>
<body>
    <h1>Book Summary</h1>

    <p id="result"></p>

    <script>
        function Book(title, author, pages) {
            this.title = title;
            this.author = author;
            this.pages = pages;

            this.summary = function() {
                return this.title + " by " + this.author +
                       " has " + this.pages + " pages.";
            };
        }

        const book1 = new Book("Harry Potter", "J.K. Rowling", 350);

        document.getElementById("result").textContent = book1.summary();
    </script>
</body>
</html>
